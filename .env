# Public frontend configuration.
# IMPORTANT: variables prefixed with VITE_ are embedded into the browser bundle.
# Do not store private secrets, database passwords, JWT secrets, or API keys here.

# HTTP API gateway URL (KrakenD in local Docker setup).
VITE_API_URL=http://localhost:8080

# Socket.IO server URL. Use the message service external port unless KrakenD proxies Socket.IO.
VITE_WS_URL=http://localhost:3005

# Socket.IO connection behavior.
VITE_SOCKET_TRANSPORTS=websocket,polling
VITE_SOCKET_RECONNECTION=true
VITE_SOCKET_RECONNECTION_ATTEMPTS=5
VITE_SOCKET_RECONNECTION_DELAY_MS=1000
VITE_SOCKET_SUBSCRIBE_MAX_RETRIES=50
VITE_SOCKET_SUBSCRIBE_RETRY_DELAY_MS=100

# Messages pagination defaults.
VITE_MESSAGES_CHAT_LIMIT=50
VITE_MESSAGES_MESSAGE_LIMIT=50
VITE_MESSAGE_LIST_PAGE_SIZE=50
VITE_MESSAGE_SCROLL_TO_BOTTOM_DELAY_MS=100

# Posts/feed defaults.
VITE_POST_FEED_LIMIT=20
VITE_POST_FEED_CACHE_SECONDS=60

# Search behavior.
VITE_SEARCH_DEBOUNCE_MS=300
VITE_SEARCH_MIN_QUERY_LENGTH=2

# UI delays.
VITE_FRIEND_STATUS_REFETCH_DELAY_MS=300
VITE_PROFILE_MESSAGE_TIMEOUT_MS=3000
VITE_PROFILE_REDIRECT_DELAY_MS=1500
VITE_PASSWORD_REDIRECT_DELAY_MS=2000

# Public social links.
VITE_SOCIAL_TELEGRAM_URL=https://t.me/yourchannel
VITE_SOCIAL_GITHUB_URL=https://github.com/yourrepo
VITE_SOCIAL_VK_URL=https://vk.com/yourpage